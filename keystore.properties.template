# ─────────────────────────────────────────────────────────────────────────────
# Codebot release signing — copy this file to keystore.properties and fill in.
# keystore.properties is gitignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────
#
# 1. Generate your keystore (one-time, keep the file somewhere safe):
#
#    keytool -genkey -v \
#      -keystore bori-code-release.jks \
#      -keyalg RSA -keysize 2048 -validity 10000 \
#      -alias mimir
#
# 2. Copy this file:  cp keystore.properties.template keystore.properties
# 3. Fill in the four values below.
# 4. Build the release AAB:  ./gradlew bundleRelease
#    Output: app/build/outputs/bundle/release/app-release.aab
# ─────────────────────────────────────────────────────────────────────────────

# Path to the .jks file — relative to the project root (or absolute)
storeFile=../bori-code-release.jks

storePassword=YOUR_STORE_PASSWORD
keyAlias=mimir
keyPassword=YOUR_KEY_PASSWORD
